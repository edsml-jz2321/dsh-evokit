{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evokit v0 proposal input",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets", "mechanism", "predicted_effect", "falsification", "prior"],
  "properties": {
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}},
    "mechanism": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "predicted_effect": {"type": "number"},
    "falsification": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "prior": {"type": "object", "additionalProperties": false,
      "required": ["attempt", "difference"],
      "properties": {"attempt": {"type": ["string", "null"]},
        "difference": {"type": "string", "minLength": 1, "pattern": "\\S"}}}
  }
}
